#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# EL GATE DEL COMMIT (S82-B r28) — paga la mitad que faltaba de D-481.
#
# POR QUÉ EXISTE, con su evidencia: D-481 declaró que "lo que se confía a
# que un humano se acuerde de correr, se incumple". El lint nació en S81
# y en S82 se probó solo: DOS de DOS rondas entraron commits con
# verify:diseno en exit 1 — el número estaba en pantalla y se siguió
# igual. Leer un exit es memoria humana; esto es mecanismo.
#
# COSTO MEDIDO (por eso corre SOLO lo tocado — un hook lento se saltea
# por costumbre y volvemos al mismo lugar por otra puerta):
#   verify:diseno 0.5s · tsc packages/ui 1.3s · tsc apps/* ~3s c/u.
#   Commit típico de un paquete: ~2s. Peor caso (toca los tres): ~8s.
#
# ESCAPE DECLARADO Y RUIDOSO: `SALTAR_GATE="motivo"` — a veces hay que
# commitear en rojo a propósito, y eso SE DECLARA. El motivo se imprime
# acá y `prepare-commit-msg` lo escribe DENTRO del mensaje, así el rastro
# sobrevive al commit. LIMITACIÓN HONESTA: `git commit --no-verify` no
# ejecuta NINGÚN hook, así que ese escape es mudo por diseño de git y no
# se puede instrumentar — queda como la puerta sin rastro.
# ─────────────────────────────────────────────────────────────────────
set -e
RAIZ=$(git rev-parse --show-toplevel)
cd "$RAIZ"

# ─────────────────────────────────────────────────────────────────────
# EL SALTO DECLARA CONTRA QUÉ MIDIÓ (S85-B9 — propuesta de B, aceptada
# por la mesa).
#
# QUÉ LO PARIÓ, con su número: CUATRO commits de C salieron con
# SALTAR_GATE por un R17 en rojo que en `main` NO EXISTÍA — medido
# después: exit 0, árbol limpio, la entrada de galería había entrado en
# el mismo commit que la creó. No se pudo reconstruir qué vio C, y ESE es
# el defecto: el motivo decía POR QUÉ se saltaba, pero nada decía CONTRA
# QUÉ ÁRBOL se había medido el rojo.
#
# ES EL HALLAZGO DE S84 EN SU FORMA MÁS CARA: un dato viejo que dice "sí"
# se descubre al chocar; uno que dice "NO SE PUEDE" no se descubre nunca,
# porque nadie verifica por qué algo NO se hizo. Cuatro gates saltados es
# el precio de no poder verificarlo.
#
# POR QUÉ EL HOOK MIDE EN VEZ DE PEDIR UN SHA, que es la decisión de
# diseño: pedir `GATE_ROJO_EN=<sha>` reproduce la enfermedad — otro dato
# tipeado a mano, que puede estar viejo o mal, y que nadie verifica. Acá
# el salto se AUTO-INSTRUMENTA: el hook estampa el HEAD real, si el árbol
# estaba sucio, y **corre el lint y anota lo que dio EN ESE INSTANTE**.
#
# LA CONSECUENCIA QUE LO VUELVE ÚTIL: si alguien salta diciendo "el lint
# está en rojo" y la medición dice VERDE, esa contradicción queda escrita
# en el mensaje del commit para siempre. Un "no se puede" falso deja de
# ser invisible y pasa a ser la línea siguiente.
#
# ALCANCE HONESTO: mide `verify:diseno` (0.5s — barato, por eso se corre
# aunque estemos saltando). NO mide los tsc: son ~3s por app y un hook
# lento se saltea por costumbre, que es cómo volvimos acá la primera vez.
# Si el rojo era de tsc, el registro lo dice y no lo disimula.
# ─────────────────────────────────────────────────────────────────────
ANCLA_SALTO="$(git rev-parse --git-dir)/GATE_SALTEADO_ANCLA"
rm -f "$ANCLA_SALTO"   # nunca heredar el rastro de un intento anterior

if [ -n "$SALTAR_GATE" ]; then
  HEAD_CORTO=$(git rev-parse --short HEAD 2>/dev/null || echo "sin-HEAD")
  if [ -n "$(git status --porcelain)" ]; then
    ESTADO_ARBOL="SUCIO ($(git status --porcelain | wc -l | tr -d ' ') archivo(s))"
  else
    ESTADO_ARBOL="limpio"
  fi
  if node scripts/verify-diseno.mjs >/dev/null 2>&1; then
    MEDIDO="VERDE"
  else
    MEDIDO="ROJO"
  fi

  echo "⚠️  GATE SALTEADO A PROPÓSITO — motivo: $SALTAR_GATE"
  echo "   medido AHORA · HEAD $HEAD_CORTO · árbol $ESTADO_ARBOL · verify:diseno $MEDIDO"
  if [ "$MEDIDO" = "VERDE" ]; then
    echo ""
    echo "   ⚠️  OJO: el lint da VERDE en este árbol. Si saltás porque lo viste"
    echo "       rojo, lo que viste era otro árbol (o otro gate: los tsc no se"
    echo "       miden acá). Esto NO te frena — queda escrito en el commit."
  fi
  echo "   (todo esto queda escrito en el mensaje del commit)"

  printf '[GATE SALTEADO] %s\n[GATE SALTEADO · medido al saltar] HEAD %s · árbol %s · verify:diseno %s\n' \
    "$SALTAR_GATE" "$HEAD_CORTO" "$ESTADO_ARBOL" "$MEDIDO" > "$ANCLA_SALTO"
  exit 0
fi

# ─────────────────────────────────────────────────────────────────────
# ① PATHSPEC OBLIGATORIO (orden founder S82, tras DOS arrastres seguidos
#    contra B en el mismo commit).
#
#    LO QUE LOS DOS ARRASTRES PROBARON: 76(f2) manda `git add` acotado y
#    ES INSUFICIENTE POR CONSTRUCCIÓN. `git add` acota lo que UNO agrega;
#    `git commit` se lleva TODO EL ÍNDICE. Entre los dos hay una ventana,
#    y con tres pistas sobre un índice esa ventana se llena — no por
#    descuido: commitear no es atómico respecto del índice ajeno.
#    Limpiar el índice antes tampoco alcanza: eso es una carrera, y B la
#    perdió dos veces seguidas contra el mismo WIP de A.
#
#    `git commit -- <rutas>` es inmune: commitea el árbol de ESAS rutas
#    ignorando el índice para todo lo demás, y deja lo ajeno donde estaba.
#
#    EL DISCRIMINADOR, medido en un repo de prueba y no supuesto: git le
#    dice al hook cuál forma se usó, porque la forma pathspec trabaja
#    sobre un índice TEMPORAL —
#      · `git commit` a secas    → GIT_INDEX_FILE = .git/index
#      · `git commit -- <rutas>` → GIT_INDEX_FILE = .git/next-index-<pid>
#    Es exacto y no depende de parsear la línea de comando (que el hook
#    no recibe).
#
#    LAS EXCEPCIONES SON DE GIT, NO DE CRITERIO: merge, cherry-pick,
#    revert y rebase construyen su commit sin que nadie pueda pasarle
#    rutas. Se detectan por los archivos de estado del propio git y pasan
#    solas — jamás por una lista de nombres que haya que mantener.
# ─────────────────────────────────────────────────────────────────────
DIRGIT=$(git rev-parse --git-dir)
ESPECIAL=""
for F in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
  [ -e "$DIRGIT/$F" ] && ESPECIAL="$F"
done
[ -d "$DIRGIT/rebase-merge" ] || [ -d "$DIRGIT/rebase-apply" ] && ESPECIAL="rebase"

case "${GIT_INDEX_FILE:-$DIRGIT/index}" in
  */next-index*) ;;                     # forma pathspec: lo que la casa exige
  *)
    if [ -n "$ESPECIAL" ]; then
      echo "── gate: commit de $ESPECIAL — pathspec no aplica acá (lo arma git), sigo."
    else
      echo "✗ COMMIT A SECAS — el commit NO ocurre."
      echo ""
      echo "  La casa commitea SIEMPRE con rutas (orden founder S82):"
      echo "      git commit -F <msg> -- <tus/rutas>"
      echo ""
      echo "  El porqué, y costó dos arrastres seguidos: 'git add' acota lo que VOS"
      echo "  agregás, pero 'git commit' se lleva TODO EL ÍNDICE — y el índice es UNO"
      echo "  solo para las tres pistas. Entre tu add y tu commit, otra pista stagea"
      echo "  lo suyo y viaja adentro del tuyo. La forma con rutas es inmune: trabaja"
      echo "  sobre un índice temporal y deja lo ajeno donde estaba."
      echo ""
      echo "  Si de verdad tenés que commitear a secas:  SALTAR_GATE=\"por qué\" git commit ..."
      exit 1
    fi
    ;;
esac

CAMBIOS=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$CAMBIOS" ] && exit 0

# ─────────────────────────────────────────────────────────────────────
# ② LA ABORTO POR CARPETA AJENA — 76(h) hecha mecánica (orden founder).
#
#    76(h) dice que cada sesión DECLARA sus archivos al abrir tanda. Eso
#    vivía en el chat, o sea en la memoria de alguien. Con `TERRITORIO`
#    declarado, el hook lo hace exigible: cualquier ruta fuera ABORTA.
#
#    POR QUÉ ABORTA Y YA NO AVISA, con su evidencia: el aviso existía,
#    imprimió las carpetas ajenas, y B siguió de largo LAS DOS VECES que
#    lo arrastró. **Un aviso que no frena, no frena** — es la misma
#    lección que parió este hook (D-481) aplicada al hook mismo.
#
#    Sin `TERRITORIO` declarado sigue avisando, porque negarle el commit
#    a quien no conoce la variable sería un gate que enseña a saltearse.
#      Uso:  TERRITORIO="packages/ui scripts" git commit -F m -- <rutas>
# ─────────────────────────────────────────────────────────────────────
N=$(echo "$CAMBIOS" | wc -l | tr -d ' ')
if [ -n "$TERRITORIO" ]; then
  AJENOS=""
  for RUTA in $CAMBIOS; do
    DENTRO=""
    for T in $TERRITORIO; do
      case "$RUTA" in "$T"*) DENTRO=1 ;; esac
    done
    [ -z "$DENTRO" ] && AJENOS="$AJENOS
   $RUTA"
  done
  if [ -n "$AJENOS" ]; then
    echo "✗ CARPETA AJENA EN TU COMMIT — el commit NO ocurre."
    echo "   territorio declarado: $TERRITORIO"
    echo "   fuera de él:$AJENOS"
    echo ""
    echo "   Si el cruce es a propósito, declaralo en el territorio (76(d) pide"
    echo "   que se DIGA, no que no se haga):  TERRITORIO=\"$TERRITORIO <la otra>\""
    exit 1
  fi
  echo "── gate del commit · $N archivo(s), todos dentro de: $TERRITORIO"
fi

# S82-B r35 — EL GATE MIDE EL ÁRBOL, NO LO STAGED (hallazgo 1 de A, NO
# CURADO y declarado): el WIP roto de una pista frena el commit de otra.
# INTENTÉ `git stash --keep-index` con trap y HAY QUE NO REPETIRLO: la
# prueba puntual pasaba, pero en uso real el hook devolvía exit 0 con
# "gate verde" SIN CREAR EL COMMIT — el `stash pop` del trap interfiere
# con la creación. Un gate que impide commitear es peor que el problema
# que resuelve. La cura probablemente sea worktrees (D-586), no más
# lógica acá.

# AVISO DE ARRASTRE — el camino de quien NO declaró TERRITORIO. Queda
# como estaba (imprime carpetas) con su limitación dicha en la cara: un
# aviso no frena. La forma pathspec de ① ya vuelve el arrastre casi
# imposible; esto es la red para el pathspec ANCHO (`-- .`).
if [ -z "$TERRITORIO" ]; then
  echo "── gate del commit · $N archivo(s) van a entrar:"
  echo "$CAMBIOS" | sed 's|/[^/]*$||' | sort -u | sed 's/^/   /'
  echo "   (sin TERRITORIO declarado esto solo AVISA — y un aviso no frena."
  echo "    Para que aborte: TERRITORIO=\"tus/rutas\" git commit -F m -- <rutas>)"
fi
node scripts/verify-diseno.mjs >/dev/null 2>&1 || {
  echo "✗ verify:diseno EN ROJO — el commit NO ocurre."
  node scripts/verify-diseno.mjs 2>&1 | grep "✗" | head -5
  echo ""
  echo "  curalo, o declaralo:  SALTAR_GATE=\"por qué\" git commit ..."
  exit 1
}

# ─────────────────────────────────────────────────────────────────────
# ②bis LA JORNADA SE ENUMERA ENTERA (S109-D, cableado por A)
#
# 🔴 POR QUÉ ESTÁ ACÁ: la guardería existía —motor, wrapper, pantalla y
#    cinco estadías vivas— y NO aparecía en TRES superficies del prestador,
#    por tres mecanismos distintos con la misma forma: un `continue` por
#    categoría, un mapa cerrado de cuatro claves, y cuatro lectores escritos
#    a mano. **Ninguno falla: los tres OMITEN.** Y una omisión no tiene
#    síntoma — el prestador leyó «hoy no tienes citas» con dos animales a
#    bordo.
#
# ⚠️ ES APTO PARA EL HOOK PORQUE **NO NECESITA RED** (medido: 0 referencias
#    a `lib-db`). Su universo sale de los lectores de `packages/api`, no de
#    una lista adentro — *una lista habría sido el sexto mapa cerrado.*
#
# 🔴 Y POR ESO SU HERMANO **NO** ESTÁ ACÁ: `verify:voz-por-tipo` **EXIGE la
#    base** (importa `lib-db`) y sin ella sale NO CONCLUYENTE. En el hook
#    dejaría **sin poder commitear a cualquiera sin red**, y un gate que
#    frena por no poder medir no protege: estorba. Su lugar es el paso ⓪ y
#    el cierre, al lado de `verify:censo` — como lo declaró su autora.
node scripts/verify-jornada-completa.mjs >/dev/null 2>&1 || {
  echo ""
  echo "✗ LA JORNADA NO SE ENUMERA ENTERA — el commit NO ocurre."
  node scripts/verify-jornada-completa.mjs 2>&1 | grep -E "✗|🔴" | head -5
  echo ""
  echo "  Una superficie que enumera la jornada y se saltea un oficio no falla:"
  echo "  OMITE. Y una omisión no tiene síntoma."
  echo ""
  echo "  curalo, o declaralo:  SALTAR_GATE=\"por qué\" git commit ..."
  exit 1
}

# ─────────────────────────────────────────────────────────────────────
# ③ EL TSC MIRA A LOS CONSUMIDORES, NO SOLO A LO QUE TOCASTE
#    (S85-B11 — hueco nombrado por A tras el incidente del día).
#
# ⚠️ EL DIAGNÓSTICO CORREGIDO, porque el pedido llegó con otro y la cura
#    habría sido inútil: **el hook YA corría tsc** desde S82-B r28. El
#    hueco no era "no corre tsc" — era que corría el tsc de lo que
#    TOCASTE, y no el de lo que DEPENDE de lo que tocaste.
#
#    EL INCIDENTE, medido y no supuesto: `00d702f` tocó SOLO
#    `packages/api` (dos wrappers) y dejó `main` con SEIS errores en
#    `apps/prestador`. Dos cosas fallaron a la vez —
#      · `packages/api` no estaba en la lista, así que no se chequeó; y
#      · **chequearlo no habría alcanzado**: medido, `packages/api`
#        typechequea VERDE por sí solo (exit 0). El tipo cambió de forma
#        coherente PARA SÍ MISMO; la rotura solo existe desde afuera.
#    Por eso la cura no es "agregar packages/api a la lista": es que un
#    cambio en un paquete COMPARTIDO se verifique en QUIEN LO CONSUME.
#    Es el patrón que el método ya nombra —*el motor se adelanta a su
#    wrapper*— atajado una capa antes.
#
# EL COSTO, MEDIDO ANTES DE IMPONERLO (la mesa pidió justamente esto, y
# el riesgo lo nombré yo: un hook lento se saltea por costumbre y
# volvemos al mismo lugar por otra puerta):
#      packages/ui 1.2s · apps/cliente 3.3s · apps/prestador 3.5s
#      en SERIE 8.0s   ·   EN PARALELO 4.4s
# Corren en paralelo: el peor caso baja de 8s a 4.4s, que es menos que
# lo que tardaba `apps/prestador` + `apps/cliente` en serie hoy. Y el
# caso típico NO cambia — commit de una sola app sigue costando lo suyo.
# El gasto grande cae exactamente donde está el peligro: tocar algo que
# otros consumen.
# ─────────────────────────────────────────────────────────────────────
VERIFICAR=""
sumar() { case " $VERIFICAR " in *" $1 "*) ;; *) VERIFICAR="$VERIFICAR $1" ;; esac; }

case "$CAMBIOS" in
  *packages/api*|*packages/ui*|*packages/domain*|*packages/i18n*)
    # PAQUETE COMPARTIDO: se verifica en sus consumidores, no en sí mismo
    sumar packages/api; sumar packages/ui
    sumar apps/cliente; sumar apps/prestador ;;
esac
case "$CAMBIOS" in *apps/cliente*) sumar apps/cliente ;; esac
case "$CAMBIOS" in *apps/prestador*) sumar apps/prestador ;; esac

if [ -n "$VERIFICAR" ]; then
  TMPTSC=$(mktemp -d)
  for P in $VERIFICAR; do
    K=$(echo "$P" | tr / _)
    ( cd "$P" && npx tsc --noEmit > "$TMPTSC/$K.log" 2>&1; echo $? > "$TMPTSC/$K.exit" ) &
  done
  wait || true
  ROJOS=""
  for P in $VERIFICAR; do
    K=$(echo "$P" | tr / _)
    [ "$(cat "$TMPTSC/$K.exit" 2>/dev/null || echo 1)" = "0" ] || ROJOS="$ROJOS $P"
  done
  if [ -n "$ROJOS" ]; then
    echo "✗ tsc EN ROJO en:$ROJOS — el commit NO ocurre."
    for P in $ROJOS; do
      K=$(echo "$P" | tr / _)
      echo "  ── $P"
      head -4 "$TMPTSC/$K.log" | sed 's/^/     /'
    done
    case "$CAMBIOS" in
      *packages/*)
        echo ""
        echo "  Tocaste un paquete COMPARTIDO, así que el gate miró a sus CONSUMIDORES:"
        echo "  un tipo puede quedar coherente para sí mismo y romper a quien lo usa."
        echo ""
        echo "  ⚠️ PERO ESTE GUARD NO SABE SI LO ROMPISTE VOS. Mide el ÁRBOL, no tu"
        echo "     cambio, así que un consumidor que YA estaba rojo —el WIP de otra"
        echo "     pista, un archivo sin trackear— sale igual acá y no es tuyo."
        echo "     Antes de buscar en lo que editaste: mirá si el rojo ya existía"
        echo "     (git stash -u && tsc, o preguntá en la mesa). Si es ajeno, esto"
        echo "     se declara con SALTAR_GATE y el motivo lo dice." ;;
    esac
    echo ""
    echo "  curalo, o declaralo:  SALTAR_GATE=\"por qué\" git commit ..."
    rm -rf "$TMPTSC"
    exit 1
  fi
  rm -rf "$TMPTSC"
  echo "── tsc verde en:$VERIFICAR"
fi
echo "✓ gate verde"
