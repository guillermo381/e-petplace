{
  "expo": {
    "name": "e-PetPlace Negocios",
    "slug": "prestador",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prestador",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0A7268"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.epetplace.prestador",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0A7268"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "La app usa el micrófono para dictar la nota de la consulta.",
          "speechRecognitionPermission": "La app usa el reconocimiento de voz para convertir tu dictado en la nota de la consulta.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A7268",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app usa la cámara para registrar la evidencia de cada atención (fotos del servicio).",
          "photosPermission": "La app accede a tus fotos solo cuando elegís una imagen como evidencia de una atención."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación durante el paseo para registrar el recorrido que ve la familia.",
          "locationAlwaysAndWhenInUsePermission": "Con el permiso \"siempre\", el recorrido se registra aunque guardes el teléfono en el bolsillo. Solo se usa mientras dura un paseo.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para grabar clips cortos del progreso en las sesiones de adiestramiento.",
          "microphonePermission": "La app usa el micrófono para que los clips de adiestramiento se escuchen (las órdenes son parte del progreso).",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "@livekit/react-native-expo-plugin",
        {
          "enableScreenShareService": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83a4d295-764e-4067-add2-e91512c06649"
      }
    },
    "owner": "guillo381",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/83a4d295-764e-4067-add2-e91512c06649"
    }
  }
}
