{
  "expo": {
    "name": "e-PetPlace",
    "slug": "cliente",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cliente",
    "userInterfaceStyle": "automatic",
    "ios": {
      "associatedDomains": [
        "applinks:www.epetplace.com",
        "applinks:epetplace.com"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Para que el veterinario pueda escucharte durante tu videoconsulta.",
        "NSCameraUsageDescription": "Para la foto de tu mascota y para tus videoconsultas con el veterinario."
      }
    },
    "android": {
      "package": "com.epetplace.cliente",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#26062E"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "www.epetplace.com", "pathPrefix": "/auth/callback" },
            { "scheme": "https", "host": "epetplace.com", "pathPrefix": "/auth/callback" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8E1F68"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D10788",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "enableScreenShareService": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Para la foto de tu mascota y para tus videoconsultas con el veterinario.",
          "photosPermission": "La app accede a tus fotos solo cuando eliges una imagen para tu mascota."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f357bfa-43c2-4c8c-983b-0bcfff40ce7d"
      }
    },
    "owner": "guillo381",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7f357bfa-43c2-4c8c-983b-0bcfff40ce7d"
    }
  }
}
